<div class = "my-5">
    <h1 class ="text-center">교수관리</h1>
    <div class ="text-end mb-3">
        <a class="btn btn-primary px-5" href="/haksa/pro/insert">교수등록</a>
    </div>
    <table id ="tbl" class="table table-striped table-hover"></table>
    <script id = "temp" type ="x-handlebars-template">
        <tbody>
            {{#each .}}
            <tr>
                <td>
                    {{PCODE}}
                </td>
                <td>
                    {{PNAME}}
                </td>
                <td>
                    {{DEPT}}
                </td>
                <td>
                    {{FDATE}}
                </td>
                <td>
                    {{TITLE}}
                </td>
                <td>
                    {{FSALARY}}
                </td>
                <td>
                    <button pcode = "{{PCODE}}" class ="btn btn-outline-danger btn-sm delete">삭제</button>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>
<script>
    getList();

    $("#tbl").on("click",".delete",function(){
        const pcode = $(this).attr("pcode");
        if(confirm(`${pcode}번 교수를 삭제하실래요?`)){
            $.ajax({
                type:"post",
                url:"/haksa/pro/delete",
                data:{pcode},
                success:function(){
                    alert(`${pcode}번 교수를 삭제했습니다.`);
                    location.href='/haksa/pro';
                },
                error:function(){
                    alert(`${pcode}번 교수 삭제를 실패했습니다.`)
                }
            })
           
        }
    });
    getList();
    function getList(){
        $.ajax({
            type:"get",
            url:"/haksa/pro/list.json",
            success:function(data){
                console.log(data);
                const temp = Handlebars.compile($('#temp').html());
                $("#tbl").html(temp(data));
            }
        });
    }
</script>